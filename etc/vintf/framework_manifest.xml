<?xml version="1.0" encoding="UTF-8"?>
<compatibility-matrix version="2.0" type="framework" level="6">
            <sepolicy>
        <kernel-sepolicy-version>30</kernel-sepolicy-version>
        <sepolicy-version>202504</sepolicy-version>
    </sepolicy>

<!-- Radio extra instances -->
<hal format="aidl" optional="true">
    <name>android.hardware.radio.modem</name>
    <version>3</version>
    <interface><name>IRadioModem</name>
        <instance>imsSlot1</instance><instance>imsSlot2</instance><instance>imsSlot3</instance>
        <instance>se1</instance><instance>se2</instance><instance>se3</instance>
    </interface>
</hal>
<hal format="aidl" optional="true">
    <name>android.hardware.radio.network</name>
    <version>3</version>
    <interface><name>IRadioNetwork</name>
        <instance>imsSlot1</instance><instance>imsSlot2</instance><instance>imsSlot3</instance>
    </interface>
</hal>
<hal format="aidl" optional="true">
    <name>android.hardware.radio.sim</name>
    <version>3</version>
    <interface><name>IRadioSim</name>
        <instance>imsSlot1</instance><instance>imsSlot2</instance><instance>imsSlot3</instance>
        <instance>se1</instance><instance>se2</instance><instance>se3</instance>
    </interface>
</hal>
<hal format="aidl" optional="true">
    <name>android.hardware.radio.voice</name>
    <version>3</version>
    <interface><name>IRadioVoice</name>
        <instance>imsSlot1</instance><instance>imsSlot2</instance><instance>imsSlot3</instance>
    </interface>
</hal>
</compatibility-matrix>
