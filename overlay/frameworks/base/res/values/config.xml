    <!-- ========== PROXIMITY / SENSORS ========== -->
    <bool name="config_proximityCheckOnWake">true</bool>
    <bool name="config_proximityCheckOnWakeEnabledByDefault">true</bool>

    <!-- Fingerprint sensor (under-display optical) -->
    <bool name="config_supportsUdfps">true</bool>
    <string name="config_udfpsVendorCode">0</string>

    <!-- ========== POWER / DOZE ========== -->
    <bool name="config_dozeAfterScreenOff">true</bool>
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>
    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>

    <!-- AOD (Always-On Display) -->
    <bool name="config_dozeSupported">true</bool>
    <bool name="config_dozePulseOnPickup">true</bool>
    <bool name="config_dozePulseOnDoubleTap">true</bool>
    <string name="config_dozeComponent">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <string name="config_dozeDoubleTapSensorType">android.sensor.double_tap</string>
    <string name="config_dozeLongPressSensorType">android.sensor.single_tap</string>

    <!-- Battery -->
    <integer name="config_criticalBatteryWarningLevel">3</integer>
    <integer name="config_lowBatteryWarningLevel">15</integer>
    <integer name="config_lowBatteryCloseWarningBump">5</integer>

    <!-- ========== CHARGING ========== -->
    <!-- A34 supports 25W wired -->
    <bool name="config_animateScreenLights">false</bool>
    <integer name="config_chargingStartedBatteryLevel">90</integer>

    <!-- ========== WIFI ========== -->
    <bool name="config_wifi_framework_wifi_dot11ax_supported">true</bool>
    <bool name="config_wifiSoftapIeee80211axSupported">true</bool>
    <string name="config_wifi_framework_sap_2G_channel_list" translatable="false">6</string>

    <!-- WiFi Direct -->
    <bool name="config_wifi_p2p_mac_randomization_supported">true</bool>

    <!-- ========== TELEPHONY ========== -->
    <!-- Dual SIM (SM-A346B is dual nano-SIM) -->
    <integer name="config_num_phone_accounts_threshold">2</integer>

    <!-- ========== NFC ========== -->
    <bool name="config_nfcControllerAlwaysOn">true</bool>

    <!-- ========== AUDIO ========== -->
    <bool name="config_hasReconfigurableAudio">true</bool>
    <bool name="config_sendAudioBecomingNoisy">true</bool>
    <bool name="config_safe_media_volume_enabled">true</bool>

    <!-- Volume steps -->
    <integer name="config_audio_ring_vol_steps">15</integer>
    <integer name="config_audio_notif_vol_steps">15</integer>
    <integer name="config_audio_alarm_vol_steps">15</integer>

    <!-- ========== CAMERA (punch-hole) ========== -->
    <string name="config_mainBuiltInDisplayCutout" translatable="false">
        M 519,72 a 35,35 0 1 0 70,0 a 35,35 0 1 0 -70,0 Z
    </string>
    <string name="config_mainBuiltInDisplayCutoutRectApproximation" translatable="false">
        M 487,0 h 136 v 136 h -136 Z
    </string>
    <bool name="config_fillMainBuiltInDisplayCutout">true</bool>

    <!-- ========== MISC ========== -->
    <!-- Vibrator -->
    <integer name="config_vibrationIntensityDefault">2</integer>
    <integer name="config_vibrationIntensityMax">3</integer>

    <!-- Navbar -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Multi-window -->
    <bool name="config_supportsMultiWindow">true</bool>
    <bool name="config_supportsSplitScreenMultiWindow">true</bool>

    <!-- USB -->
    <string name="config_usbSuperSpeedActiveProjections" translatable="false"></string>

</resources>