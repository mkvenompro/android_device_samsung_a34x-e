<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========== DISPLAY ========== -->
    <!-- A34 is 6.6" FHD+ 120Hz SuperAMOLED -->
    <integer name="config_screenDensityDpi">390</integer>

    <!-- 120Hz support -->
    <bool name="config_highRefreshRateBlacklist">false</bool>

